<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.group04.scrapbookwidget.ui.SettingViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000">

        <LinearLayout
            android:id="@+id/mainContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Toolbar area with back button -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:paddingHorizontal="8dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/back"
                    android:src="@drawable/ic_back"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Profile Section -->
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/imgProfile"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:padding="4dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/account_circle_24"
                            android:contentDescription="@string/edit_photo"
                            app:shapeAppearanceOverlay="@style/CircleAppearance"
                            app:strokeColor="#FFD700"
                            app:strokeWidth="3dp" />

                        <ProgressBar
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:visibility="@{viewModel.isUploading ? android.view.View.VISIBLE : android.view.View.GONE}" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvProfileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@{viewModel.currentUser.displayName ?? @string/app_name}"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="Trâm Võ" />

                    <TextView
                        android:id="@+id/tvUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{`@` + (viewModel.currentUser.username ?? `user`)}"
                        android:textColor="#888888"
                        android:textSize="14sp"
                        tools:text="@tremolitee" />

                    <TextView
                        android:id="@+id/btnEditProfile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:padding="8dp"
                        android:text="@string/edit_profile"
                        android:textColor="#FFD700"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Gold Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_gold_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="20dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/heart_filled_24"
                            android:contentDescription="@null"
                            app:tint="#FFD700" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/premium_plan"
                                android:textColor="#FFFFFF"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/locket_gold_subtitle"
                                android:textColor="#CCCCCC"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Rollcall Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_chat_bubble"
                        android:backgroundTint="#1A1A1A"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_send"
                            android:rotation="-45"
                            android:contentDescription="@null"
                            app:tint="#FFFFFF" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/rollcall"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/rollcall_subtitle"
                                android:textColor="#AAAAAA"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_palette"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="@string/pick_yours"
                            android:textColor="#FFD700"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Invite Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_chat_bubble"
                        android:backgroundTint="#1A1A1A"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/account_circle_24"
                            android:contentDescription="@null"
                            app:shapeAppearanceOverlay="@style/CircleAppearance"
                            app:strokeColor="#FFD700"
                            app:strokeWidth="1dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/invite_friends"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@{`locket.cam/` + (viewModel.currentUser.username ?? `user`)}"
                                android:textColor="#AAAAAA"
                                android:textSize="12sp"
                                tools:text="locket.cam/tremolitee" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_send"
                            android:contentDescription="@null"
                            app:tint="#FFFFFF" />
                    </LinearLayout>

                    <!-- Widget Setup Section -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:layout_marginBottom="16dp"
                        android:text="@string/widget_setup"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <include
                        android:id="@+id/btnAddWidget"
                        layout="@layout/item_setting"
                        app:icon="@{@drawable/ic_add}"
                        app:title="@{@string/add_widget}" />

                    <include
                        android:id="@+id/btnHowToAddWidget"
                        layout="@layout/item_setting"
                        app:icon="@{@drawable/ic_help}"
                        app:title="@{@string/how_to_add_widget}" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="12dp">

                        <ImageView
                            android:id="@+id/icStreak"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_flash"
                            android:contentDescription="@null"
                            app:tint="#FFFFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/icStreak"
                            android:layout_toStartOf="@+id/switchStreak"
                            android:text="@string/streak_on_widget"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchStreak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:checked="@{viewModel.streakEnabled}"
                            android:onCheckedChanged="@{(view, isChecked) -> viewModel.setStreakEnabled(isChecked)}" />
                    </RelativeLayout>

                    <!-- General Section -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:layout_marginBottom="16dp"
                        android:text="@string/general"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <include
                        android:id="@+id/btnNotifications"
                        layout="@layout/item_setting"
                        app:icon="@{@drawable/ic_notifications}"
                        app:title="@{@string/notifications}" />

                    <include
                        android:id="@+id/btnEditName"
                        layout="@layout/item_setting"
                        app:icon="@{@drawable/account_circle_24}"
                        app:title="@{@string/edit_name}"
                        app:subtitle="@{viewModel.currentUser.displayName}"/>

                    <include
                        android:id="@+id/btnChangeEmail"
                        layout="@layout/item_setting"
                        app:icon="@{@drawable/ic_email}"
                        app:title="@{@string/change_email}"
                        app:subtitle="@{viewModel.currentUser.email}"/>

                    <!-- Support Section -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:layout_marginBottom="16dp"
                        android:text="@string/support"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <include
                        android:id="@+id/btnMakeSuggestion"
                        layout="@layout/item_setting"
                        app:icon="@{@drawable/ic_help}"
                        app:title="@{@string/make_suggestion}" />

                    <include
                        android:id="@+id/btnReportProblem"
                        layout="@layout/item_setting"
                        app:icon="@{@drawable/ic_help}"
                        app:title="@{@string/report_problem}" />

                    <!-- Danger Zone Section -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:layout_marginBottom="16dp"
                        android:text="@string/danger_zone"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <include
                        android:id="@+id/btnSignOut"
                        layout="@layout/item_setting"
                        app:icon="@{@drawable/ic_back}"
                        app:title="@{@string/sign_out}" />

                    <include
                        android:id="@+id/btnDeleteAccount"
                        layout="@layout/item_setting"
                        app:icon="@{@drawable/ic_security}"
                        app:title="@{@string/delete_account}"
                        app:titleColor="@{@color/red}" />

                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- Full screen image overlay -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/fullScreenOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#CC000000"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/imgFullScreen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:src="@drawable/account_circle_24" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
