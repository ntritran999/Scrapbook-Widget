<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/app_nav"
    app:startDestination="@id/authLoginFragment">
    <fragment
        android:id="@+id/authLoginFragment"
        android:name="com.group04.scrapbookwidget.ui.auth.login.AuthLoginFragment"
        android:label="AuthLoginFragment"
        tools:layout="@layout/fragment_auth_login">
        <action
            android:id="@+id/action_authLoginFragment_to_authRegisterFragment"
            app:destination="@id/authRegisterFragment" />
        <action
            android:id="@+id/action_authLoginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/app_nav"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/authRegisterFragment"
        android:name="com.group04.scrapbookwidget.ui.auth.register.AuthRegisterFragment"
        android:label="AuthRegisterFragment"
        tools:layout="@layout/fragment_auth_register">
        <action
            android:id="@+id/action_authRegisterFragment_to_authLoginFragment"
            app:destination="@id/authLoginFragment" />
    </fragment>
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.group04.scrapbookwidget.ui.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_chatFragment"
            app:destination="@id/chatFragment" />
        <action
            android:id="@+id/action_homeFragment_to_settingFragment"
            app:destination="@id/settingFragment" />
    </fragment>
    <fragment
        android:id="@+id/chatFragment"
        android:name="com.group04.scrapbookwidget.ui.group.ChatFragment"
        android:label="fragment_chat"
        tools:layout="@layout/fragment_chat" >
        <action
            android:id="@+id/action_chatFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_chatFragment_to_chatDetailFragment"
            app:destination="@id/chatDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/chatDetailFragment"
        android:name="com.group04.scrapbookwidget.ui.group.GroupFragment"
        android:label="fragment_group"
        tools:layout="@layout/fragment_group" >
        <action
            android:id="@+id/action_chatDetailFragment_to_groupSettingsFragment"
            app:destination="@id/groupSettingsFragment" />
    </fragment>
    <fragment
        android:id="@+id/groupSettingsFragment"
        android:name="com.group04.scrapbookwidget.ui.group.GroupSettingsFragment"
        android:label="GroupSettingsFragment"
        tools:layout="@layout/fragment_group_settings" >
        <action
            android:id="@+id/action_groupSettingsFragment_to_memberListFragment"
            app:destination="@id/memberListFragment" />
        <action
            android:id="@+id/action_groupSettingsFragment_to_inviteUserFragment"
            app:destination="@id/inviteUserFragment" />
    </fragment>
    <fragment
        android:id="@+id/memberListFragment"
        android:name="com.group04.scrapbookwidget.ui.group.MemberListFragment"
        android:label="MemberListFragment"
        tools:layout="@layout/fragment_member_list" />
    <fragment
        android:id="@+id/inviteUserFragment"
        android:name="com.group04.scrapbookwidget.ui.group.InviteUserFragment"
        android:label="InviteUserFragment"
        tools:layout="@layout/fragment_invite_user" />
    <fragment
        android:id="@+id/settingFragment"
        android:name="com.group04.scrapbookwidget.ui.SettingFragment"
        android:label="SettingFragment"
        tools:layout="@layout/fragment_setting">
        <action
            android:id="@+id/action_settingFragment_to_editProfileFragment"
            app:destination="@id/editProfileFragment" />
        <action
            android:id="@+id/action_settingFragment_to_createGroupFragment"
            app:destination="@id/createGroupFragment" />
        <action
            android:id="@+id/action_settingFragment_to_notificationSettingFragment"
            app:destination="@id/notificationSettingFragment" />
    </fragment>
    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.group04.scrapbookwidget.ui.profile.EditProfileFragment"
        android:label="EditProfileFragment"
        tools:layout="@layout/fragment_edit_profile" />
    <fragment
        android:id="@+id/createGroupFragment"
        android:name="com.group04.scrapbookwidget.ui.group.create.CreateGroupFragment"
        android:label="CreateGroupFragment"
        tools:layout="@layout/fragment_create_group" />
    <fragment
        android:id="@+id/notificationSettingFragment"
        android:name="com.group04.scrapbookwidget.ui.NotificationSettingFragment"
        android:label="NotificationSettingFragment"
        tools:layout="@layout/fragment_notification_setting" />
</navigation>